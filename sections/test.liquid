{% comment %} <h1>{{ shop.name }}</h1>
  <img
    src="{{product.featured_image |  image_url: width: 200}}"
    alt="{{ product.title }}"
    width="200"
  height="200"> {% endcomment %}

{% if product %}
  <h1>{{ product.title }}</h1>
  <img
    src="{{ product.featured_image | image_url: width: 200 }}"
    alt="{{ product.title }}"
    width="200"
    height="200">
{% else %}
  <h1>{{ shop.name }}</h1>
{% endif %}