<div class="quantity-wrapper">

  <label for="Quantity">
    Quantity
  </label>


  <div class="quantity-box">

    <button
      type="button"
      class="quantity-btn"
      data-quantity-action="decrease">
      −
    </button>


    <input
      type="number"
      id="Quantity"
      name="quantity"
      value="1"
      min="1">


    <button
      type="button"
      class="quantity-btn"
      data-quantity-action="increase">
      +
    </button>

  </div>

</div>


<style>

  .quantity-wrapper {
    margin-top: 20px;
