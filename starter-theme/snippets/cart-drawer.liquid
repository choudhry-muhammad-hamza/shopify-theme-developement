<div id="cartOverlay" class="cart-overlay"></div>


<aside
  id="cartDrawer"
  class="cart-drawer"
  aria-hidden="true"
  data-currency="{{ shop.currency }}">


  <div class="cart-drawer__header">

    <h2>
      Your Cart
    </h2>


    <button
      type="button"
      class="cart-drawer__close"
      id="cartDrawerClose">
      ×
    </button>

  </div>


  <div id="cartDrawerContent" class="cart-drawer__content">

    {% render 'cart-drawer-content' %}

  </div>

</aside>


<style>

  .cart-overlay {

    position: fixed;

    inset: 0;

    background: rgba(0, 0, 0, 0.45);

    opacity: 0;

    visibility: hidden;

    transition: 0.3s;

    z-index: 9998;

  }


  .cart-overlay.active {

    opacity: 1;

    visibility: visible;

  }


  .cart-drawer {

    position: fixed;

    top: 0;

    right: 0;

    width: 420px;

    max-width: 100%;

    height: 100 dvh;

    background: #fff;

    z-index: 9999;

    transform: translateX(100%);

    transition: transform 0.3s ease;

    display: flex;

    flex-direction: column;

  }


  .cart-drawer.active {

    transform: translateX(0);

  }


  .cart-drawer__header {

    display: flex;

    justify-content: space-between;

    align-items: center;

    padding: 20px;

    border-bottom: 1px solid #ddd;

  }


  .cart-drawer__header h2 {

    margin: 0;

  }


  .cart-drawer__close {

    border: none;

    background: transparent;

    font-size: 30px;

    cursor: pointer;

  }


  .cart-drawer__content {

    flex: 1;

    overflow-y: auto;

    padding: 20px;

  }


  .cart-item {

    display: flex;

    gap: 15px;

    padding-bottom: 20px;

    margin-bottom: 20px;

    border-bottom: 1px solid #ddd;

  }


  .cart-item__image img {

    width: 90px;

    height: 90px;

    object-fit: cover;

  }


  .cart-item__details {

    flex: 1;

  }


  .cart-item__title {

    color: #111;

    text-decoration: none;

    font-weight: 600;

  }


  .cart-item__variant {

    font-size: 13px;

    color: #666;

  }


  .cart-item__price {

    margin-top: 8px;

    font-weight: 600;

  }


  .cart-item__bottom {

    margin-top: 12px;

  }


  .cart-quantity {

    display: flex;

    align-items: center;

    width: fit-content;

    border: 1px solid #ddd;

  }


  .cart-quantity__button {

    width: 32px;

    height: 32px;

    border: none;

    background: #f5f5f5;

    cursor: pointer;

  }


  .cart-quantity__value {

    width: 35px;

    text-align: center;

  }


  .cart-item__remove {

    margin-top: 8px;

    border: none;

    background: none;

    padding: 0;

    cursor: pointer;

    text-decoration: underline;

  }


  .cart-drawer__footer {

    border-top: 1px solid #ddd;

    padding: 20px;

  }


  .cart-subtotal {

    display: flex;

    justify-content: space-between;

    margin-bottom: 15px;

  }


  .cart-view-button,
  .cart-checkout-button {

    display: block;

    width: 100%;

    padding: 14px;

    text-align: center;

    text-decoration: none;

    box-sizing: border-box;

    margin-top: 10px;

  }


  .cart-view-button {

    border: 1px solid #111;

    color: #111;

  }


  .cart-checkout-button {

    background: #111;

    color: #fff;

  }


  .cart-empty {

    text-align: center;

    padding: 50px 20px;

  }


  .cart-empty__icon {

    font-size: 50px;

  }


  .cart-empty__button {

    display: inline-block;

    margin-top: 20px;

    padding: 12px 20px;

    background: #111;

    color: white;

    text-decoration: none;

  }


  @media (max-width: 500px) {

    .cart-drawer {

      width: 100%;

    }

  }

</style>


<script src="{{ 'cart-drawer.js' | asset_url }}" defer></script>